{
  "name": "lorahome",
  "version": "0.1.0",
  "private": true,
  "description": "No-code IoT automation platform for ESP32 over LoRa P2P — zero-recompile config, CBOR wire format, static rule engine.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "dev": "pnpm --parallel --filter=./packages/* dev",
    "dev:host": "pnpm --filter @lorahome/host dev",
    "dev:web": "pnpm --filter @lorahome/web dev",
    "lint": "pnpm -r --filter=./packages/* lint",
    "test": "pnpm -r --filter=./packages/* test",
    "typecheck": "pnpm -r --filter=./packages/* typecheck",
    "clean": "pnpm -r --filter=./packages/* clean",
    "check:circular": "madge --circular --extensions ts,tsx packages/protocol/src packages/host/src packages/components/src packages/web/src",
    "measure:build": "node tools/measure-build.mjs",
    "gen:c": "pnpm --filter @lorahome/protocol gen:c",
    "gen:c:check": "pnpm --filter @lorahome/protocol gen:c -- --check",
    "check:targets": "node tools/compile-targets.mjs",
    "test:native": "node tools/run-native.mjs",
    "test:unity": "node tools/run-unit-tests.mjs",
    "build:firmware": "node tools/build-firmware.mjs",
    "check:airtime": "node tools/check-airtime.mjs",
    "check:slip": "node tools/check-slip-cross.mjs",
    "check:bridge-stat": "node tools/check-bridge-stat.mjs",
    "soak": "pnpm --filter @lorahome/tools build && node tools/dist/src/soak/link-soak-cli.js",
    "soak:selfcheck": "pnpm --filter @lorahome/tools build && node tools/dist/src/soak/link-soak-cli.js --loopback --duration 30s --interval 100ms --warmup 5s --timeout 2s --label soak.loopback",
    "bench:all": "node tools/collect-metrics.mjs",
    "bench:baseline": "node tools/collect-metrics.mjs --write-baseline",
    "test:all": "pnpm -r test",
    "gate": "pnpm --filter @lorahome/tools build && node tools/dist/src/metric-gate-cli.js",
    "prepare": "husky",
    "release:notes": "pnpm --filter @lorahome/tools build && node tools/dist/src/release-notes-cli.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "madge": "^8.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
