{
  "name": "@lorahome/components",
  "version": "0.1.0",
  "private": true,
  "description": "JSON manifests describing sensor/actuator capabilities, plus the loader and TS types used to render UI and generate CBOR from them.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" },
    "./schema": { "types": "./dist/src/schema.d.ts", "default": "./dist/src/schema.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  }
}
