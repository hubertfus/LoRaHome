{
  "name": "@lorahome/web",
  "version": "0.1.0",
  "private": true,
  "description": "React + React Flow UI: rule graph editor, manifest-driven forms, dry-run simulator, time-travel debug.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "pnpm run test:build && node --test dist-test/test/*.test.js",
    "test:build": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist dist-test"
  },
  "dependencies": {
    "@lorahome/components": "workspace:*",
    "@lorahome/protocol": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "reactflow": "^11.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
